# Jadi-Buti backend environment (copy to .env). Never commit .env.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>
MONGODB_DB=JadiButi
JWT_ACCESS_SECRET=change-me-long-random
JWT_REFRESH_SECRET=change-me-long-random-2
ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_TTL=60d
# Directory for uploaded prescription images (server-side only, never public)
STORAGE_DIR=./storage
# Optional: Anthropic key enables AI prescription extraction. Without it the app falls back to manual entry.
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-opus-5
